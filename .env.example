# Signing secret for stream URLs (HMAC-SHA256)
SIGNING_SECRET=replace-with-a-long-random-secret

# Telegram application credentials (https://my.telegram.org)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT1_TOKEN=
BOT1_USERNAME=

# Archive channel: numeric id with the -100 prefix, and its access hash
ARCHIVE_CHANNEL_ID=-1000000000000
CHANNEL_ACCESS_HASH=

# Pre-authorized StringSession for the home DC and optional per-DC sessions
MTPROTO_SESSION=
DC1_SESSION=
DC2_SESSION=
DC3_SESSION=

# Cloudflare accounts (one per worker). str1 uses CF_ACCOUNT_2_*, str2 -> 3, ...
CF_ACCOUNT_2_ID=
CF_ACCOUNT_2_TOKEN=
